                  {
                    "id": "meds_written_instructions",
                    "label": {
                      "en": "I have written instructions and a schedule"
                    }
                  },
                  {
                    "id": "meds_prescriptions_filled",
                    "label": {
                      "en": "Prescriptions are filled or on the way"
                    }
                  },
                  {
                    "id": "meds_supplies_ready",
                    "label": {
                      "en": "I have any needed supplies (syringes, feeding pump, oxygen, etc.)"
                    }
                  },
                  {
                    "id": "meds_side_effects",
                    "label": {
                      "en": "I know what side effects should prompt a call"
                    }
                  }
                ]
              },
